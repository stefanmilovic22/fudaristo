# Kopiraj u .env.local i popuni stvarnim vrednostima (.env.local se NE komituje)

# Supabase — Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# API-Football (api-football.com ili RapidAPI)
API_FOOTBALL_KEY=

# Tajni token koji cron ruta proverava (izmisli bilo koji dugačak random string)
CRON_SECRET=

# reCAPTCHA v3 (google.com/recaptcha/admin) — štiti formu za registraciju.
# OBA ili NIJEDAN: ako je podešen samo jedan, registracija namerno pada, da se
# pogrešan deploy ne završi tiho isključenom zaštitom.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# Postavi i u Vercel Project Settings → Environment Variables za produkciju
